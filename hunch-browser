#!/usr/bin/env bash
#
# hunch-browser: use the browser registered in hunch. Never prompts.
#

set -e

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 <command> [args]

Commands:
  find              Show the browser: id, address, handler
  context           JSON: active tab, selection, open tabs
  selection         Selected text in the active tab
  read              Text of the active tab
  dom [SELECTOR]    HTML of the elements SELECTOR matches, or of the page
EOF
}

bad_usage() {
  usage >&2
  exit 1
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
[ $# -ge 1 ] || bad_usage

ID=$(hunch find browser) ||
  die "No browser in this tmux window. Register one from a pane of it"
ADDR=$(hunch get --id "$ID" addr) ||
  die "Browser $ID has no address, restart its server"
HANDLER=$(hunch get --id "$ID" handler) ||
  die "Browser $ID has no handler, restart its server"

case "$1" in
  find)
    [ $# -eq 1 ] || bad_usage
    echo "id $ID"
    echo "addr $ADDR"
    echo "handler $HANDLER"
    ;;
  context | selection | read)
    [ $# -eq 1 ] || bad_usage
    "$HANDLER" "$ADDR" "$1"
    ;;
  dom)
    [ $# -le 2 ] || bad_usage
    "$HANDLER" "$ADDR" dom "${@:2}"
    ;;
  *)
    bad_usage
    ;;
esac
