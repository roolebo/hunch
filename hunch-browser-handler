#!/usr/bin/env bash
#
# hunch-browser-handler: the browser protocol through hunch-browser-server
# at ADDR. Never prompts.
#
#   hunch-browser-handler ADDR COMMAND [ARGUMENTS]
#

set -e

# Longer than the server waits for the browser, so its error comes first
MAX_TIME=60

die() {
  echo "$*" >&2
  exit 1
}

[ $# -ge 2 ] || die "Usage: $0 ADDR COMMAND [ARGUMENTS]"
ADDR=$1
COMMAND=$2
shift 2

REQUEST=$(jq -n --arg command "$COMMAND" \
  '{command: $command, args: $ARGS.positional}' --args "$@")
REPLY=$(curl -sS --max-time "$MAX_TIME" -H 'Content-Type: application/json' \
  --data-binary "$REQUEST" "$ADDR/command") ||
  die "hunch-browser-server doesn't answer: is it still running?"

ERROR=$(jq -r '.error // empty' <<< "$REPLY")
[ -z "$ERROR" ] || die "$ERROR"
jq -r 'if .result == null then empty else .result end' <<< "$REPLY"
