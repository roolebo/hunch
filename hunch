#!/usr/bin/env bash
# hunch: minimal tmux implementation
#
#   hunch set NAME VALUE
#   hunch clear
#   hunch get [-i|--id ID] NAME
#   hunch find ROLE
#
# ID identifies a participant, as printed by find. Without it, get reads the
# caller's own properties. A role has only letters, digits, - and _.
#

: ${HUNCH_PREFIX:=hunch}
PREFIX="@${HUNCH_PREFIX}"

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  echo "usage: $0 set NAME VALUE | $0 clear | $0 get [-i|--id ID] NAME | $0 find ROLE" >&2
  exit 2
}

tmux_available() {
  [ -n "$TMUX" ]
}

pane_available() {
  [ -n "$TMUX_PANE" ]
}

# Keep the role from breaking the tmux format in find or injecting a shell
# command
check_role() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] ||
    die "Invalid role: $1. Use letters, digits, - and _"
}

hunch_options() {
  tmux show -p -t "$TMUX_PANE" | cut -d ' ' -f 1 | grep "^${PREFIX}_"
}

# tmux hooks have no TMUX_PANE
if ! tmux_available; then
  exit 1
fi

case "$1" in
  can-join)
    pane_available
    exit $?
    ;;
  set)
    pane_available || exit 1
    if [ $# -ne 3 ]; then
      usage
    fi
    if [ "$2" == role ]; then
      check_role "$3"
    fi
    tmux set -p -t "$TMUX_PANE" "${PREFIX}_$2" "$3"
    ;;
  clear)
    pane_available || exit 1
    for option in $(hunch_options); do
      tmux set -p -u -t "$TMUX_PANE" "$option"
    done
    ;;
  get)
    shift
    target=$TMUX_PANE
    if [ "$1" == -i -o "$1" == --id ]; then
      [ $# -ge 2 ] || usage
      target=$2
      shift 2
    fi
    if [ $# -ne 1 ]; then
      usage
    fi
    [ -n "$target" ] || exit 1
    tmux show -p -v -t "$target" "${PREFIX}_$1" 2> /dev/null
    ;;
  find)
    pane_available || exit 1
    if [ $# -ne 2 ]; then
      usage
    fi
    check_role "$2"
    # Nearest participant with the role: the caller's window, then its
    # session, then all sessions
    window=""
    session=-s
    all=-a
    has_role="#{==:#{${PREFIX}_role},$2}"
    for scope in "$window" "$session" "$all"; do
      id=$(tmux list-panes $scope -t "$TMUX_PANE" -f "$has_role" \
        -F '#{pane_id}' | head -n 1)
      if [ -n "$id" ]; then
        echo "$id"
        exit 0
      fi
    done
    exit 1
    ;;
  *)
    usage
    ;;
esac
