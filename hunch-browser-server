#!/usr/bin/env python3
#
# hunch-browser-server: registers the browser in hunch and passes the
# agent's commands to the browser extensions connected to it.
#
# Run it in a tmux pane of the agent's window: hunch finds participants
# there. An extension can't listen, so each one polls this server for
# commands and posts the replies back; README.md specifies how. Several
# browsers can connect at once: commands go to the one the human used
# last. Extensions authenticate with HUNCH_BROWSER_TOKEN; the handler, on
# this host, with a secret in the address it's registered with.
#

import argparse
import hmac
import itertools
import json
import os
import queue
import secrets
import signal
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

# Seconds a poll waits for a command before the extension polls again
POLL_WAIT = 25
# Seconds a command waits for the extension's reply
REPLY_WAIT = 30
HANDLER = Path(__file__).resolve().parent / "hunch-browser-handler"


class Browser:
    """One connected extension: its commands and whether it still polls."""

    def __init__(self):
        self.commands = queue.Queue()
        self.polls = 0
        self.last_poll = time.monotonic()

    def connected(self):
        # Between two polls the extension runs a command, which can take
        # up to REPLY_WAIT
        return self.polls > 0 or time.monotonic() - self.last_poll < REPLY_WAIT


class Browsers:
    """The connected browsers, and the replies the agent waits for."""

    def __init__(self):
        self.browsers = {}
        self.focused = None
        self.waiting = {}
        self.lock = threading.Lock()
        self.ids = itertools.count(1)

    def target(self):
        """The browser the human used last, or the one that polled last."""
        connected = {
            name: browser
            for name, browser in self.browsers.items()
            if browser.connected()
        }
        if self.focused in connected:
            return connected[self.focused]
        return max(connected.values(), key=lambda b: b.last_poll, default=None)

    def run(self, command, args):
        with self.lock:
            browser = self.target()
            if browser is None:
                return {
                    "error": "No browser connected: check the server "
                    "address and token in the extension's preferences"
                }
            id = next(self.ids)
            done = threading.Event()
            self.waiting[id] = {"done": done}
        browser.commands.put({"id": id, "command": command, "args": args})
        answered = done.wait(REPLY_WAIT)
        with self.lock:
            reply = self.waiting.pop(id).get("reply")
        if not answered:
            return {"error": f"The browser didn't answer in {REPLY_WAIT} s"}
        return reply

    def next(self, name):
        """The next command still awaited for browser NAME, or None after
        POLL_WAIT."""
        with self.lock:
            browser = self.browsers.setdefault(name, Browser())
            browser.polls += 1
        deadline = time.monotonic() + POLL_WAIT
        try:
            while True:
                command = browser.commands.get(
                    timeout=max(0, deadline - time.monotonic())
                )
                # A command that timed out must not run later
                with self.lock:
                    if command["id"] in self.waiting:
                        return command
        except queue.Empty:
            return None
        finally:
            with self.lock:
                browser.polls -= 1
                browser.last_poll = time.monotonic()

    def focus(self, name):
        with self.lock:
            self.focused = name

    def answer(self, reply):
        with self.lock:
            slot = self.waiting.get(reply.get("id"))
            if slot is None:
                return
            slot["reply"] = {
                key: reply[key] for key in ("result", "error") if key in reply
            }
            slot["done"].set()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path, name = self.route()
        if path != "/poll":
            return self.reply(404, {"error": f"No such path: {path}"})
        if not self.from_extension():
            return self.reply(401, {"error": "Wrong token"})
        if not name:
            return self.reply(400, {"error": "No browser id: ?browser=ID"})
        command = BROWSERS.next(name)
        if command is None:
            return self.reply(204)
        self.reply(200, command)

    def do_POST(self):
        path, name = self.route()
        length = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(length) or "null")
        except json.JSONDecodeError as e:
            return self.reply(400, {"error": f"Body isn't JSON: {e}"})
        if hmac.compare_digest(path, f"/{SECRET}/command"):
            reply = BROWSERS.run(body["command"], body["args"])
            print(body["command"], "error" if "error" in reply else "ok")
            return self.reply(200, reply)
        if path not in ("/reply", "/focus"):
            return self.reply(404, {"error": f"No such path: {path}"})
        if not self.from_extension():
            return self.reply(401, {"error": "Wrong token"})
        if path == "/reply":
            if not isinstance(body, dict):
                return self.reply(400, {"error": "A reply is a JSON object"})
            BROWSERS.answer(body)
        elif name:
            BROWSERS.focus(name)
        else:
            return self.reply(400, {"error": "No browser id: ?browser=ID"})
        self.reply(204)

    def route(self):
        url = urlsplit(self.path)
        name = parse_qs(url.query).get("browser", [""])[0]
        return url.path, name

    def from_extension(self):
        token = self.headers.get("Authorization", "")
        return hmac.compare_digest(token, f"Bearer {TOKEN}")

    def reply(self, status, body=None):
        data = b"" if body is None else json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    # Polls would fill the pane every POLL_WAIT
    def log_message(self, format, *args):
        pass


def hunch(*args):
    try:
        subprocess.run(["hunch", *args], check=True)
    except (OSError, subprocess.CalledProcessError) as e:
        sys.exit(f"hunch {args[0]} failed ({e}): run this in a tmux pane")


def leave(signum, frame):
    sys.exit(0)


def main():
    parser = argparse.ArgumentParser(
        description="Register the browser in hunch and serve its extensions."
    )
    parser.add_argument(
        "--listen",
        default="127.0.0.1:8765",
        metavar="HOST:PORT",
        help="where the extensions connect (default: %(default)s)",
    )
    host, port = parser.parse_args().listen.rsplit(":", 1)

    global TOKEN, SECRET, BROWSERS
    TOKEN = os.environ.get("HUNCH_BROWSER_TOKEN")
    if not TOKEN:
        sys.exit("Set HUNCH_BROWSER_TOKEN to the token the extensions send")
    SECRET = secrets.token_urlsafe(16)
    BROWSERS = Browsers()

    server = ThreadingHTTPServer((host, int(port)), Handler)
    local = "127.0.0.1" if host == "0.0.0.0" else host
    hunch("set", "role", "browser")
    hunch("set", "addr", f"http://{local}:{port}/{SECRET}")
    hunch("set", "handler", str(HANDLER))
    signal.signal(signal.SIGTERM, leave)
    signal.signal(signal.SIGHUP, leave)
    print(f"Serving browser extensions at http://{host}:{port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        hunch("clear")


if __name__ == "__main__":
    main()
