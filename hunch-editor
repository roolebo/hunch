#!/usr/bin/env bash
#
# hunch-editor: use the editor registered in hunch. Never prompts.
#

set -e

MUST_USE_PROTOCOL=2

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 <command> [args]

Commands:
  find                            Show the editor: id, address, handler
  context                         JSON: file, cursor, mode, selection, buffers
  selection                       Selected text, active or last
  read BUFFER [START] [END]       Numbered lines, unsaved changes included
  open FILE [LINE [COL]]          Show FILE to the user at LINE and COL
  replace FILE 3<<'OLD' 4<<'NEW'  Replace the only match of OLD with NEW, save
  create FILE <<'EOF'             Create FILE from stdin, save
  review RANGE                    Show commits of RANGE in this repo to the user
  reload                          Re-read files changed on disk
  guard FILE                      Check if FILE may skip the editor protocol
EOF
}

bad_usage() {
  usage >&2
  exit 1
}

abspath() {
  case "$1" in
    /*) echo "$1" ;;
    *) echo "$PWD/$1" ;;
  esac
}

existing_dir() {
  local dir
  dir=$(dirname "$1")
  while [ ! -d "$dir" ]; do
    dir=$(dirname "$dir")
  done
  echo "$dir"
}

# A linked worktree has its own git dir; the human's main tree doesn't
in_linked_worktree() {
  local git_dir
  local common_dir
  git_dir=$(git -C "$1" rev-parse --absolute-git-dir 2> /dev/null) ||
    return 1
  common_dir=$(git -C "$1" rev-parse --path-format=absolute \
    --git-common-dir)
  [ "$git_dir" != "$common_dir" ]
}

guard() {
  case "$1" in
    /tmp/*) return 0 ;;
  esac
  in_linked_worktree "$(existing_dir "$1")" && return 0
  # No editor is not an error, only the reason to allow the change
  hunch find editor > /dev/null 2>&1 || return 0
  echo "$1 must change through the editor protocol" >&2
  exit "$MUST_USE_PROTOCOL"
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
[ $# -ge 1 ] || bad_usage

if [ "$1" == guard ]; then
  [ $# -eq 2 -a -n "$2" ] || bad_usage
  guard "$(abspath "$2")"
  exit 0
fi

ID=$(hunch find editor) ||
  die "No editor in this tmux window. Start one in it with hunch support"
ADDR=$(hunch get --id "$ID" addr) ||
  die "Editor $ID has no address, restart it"
HANDLER=$(hunch get --id "$ID" handler) ||
  die "Editor $ID has no handler, update its hunch plugin and restart it"

case "$1" in
  find)
    [ $# -eq 1 ] || bad_usage
    echo "id $ID"
    echo "addr $ADDR"
    echo "handler $HANDLER"
    ;;
  context | selection)
    [ $# -eq 1 ] || bad_usage
    "$HANDLER" "$ADDR" "$1"
    ;;
  read)
    [ $# -ge 2 -a $# -le 4 ] || bad_usage
    BUFFER=$2
    # A relative path becomes absolute, a buffer from context stays
    [ ! -e "$BUFFER" ] || BUFFER=$(abspath "$BUFFER")
    "$HANDLER" "$ADDR" read "$BUFFER" "${@:3}"
    ;;
  open)
    [ $# -ge 2 -a $# -le 4 ] || bad_usage
    "$HANDLER" "$ADDR" open "$(abspath "$2")" "${@:3}"
    ;;
  replace)
    [ $# -eq 2 ] || bad_usage
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    cat <&3 > "$TMP/old" || die "Old text expected on fd 3: 3<<'OLD'"
    cat <&4 > "$TMP/new" || die "New text expected on fd 4: 4<<'NEW'"
    "$HANDLER" "$ADDR" replace "$(abspath "$2")" "$TMP/old" "$TMP/new"
    ;;
  create)
    [ $# -eq 2 ] || bad_usage
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    cat > "$TMP/content"
    "$HANDLER" "$ADDR" create "$(abspath "$2")" "$TMP/content"
    ;;
  review)
    [ $# -eq 2 ] || bad_usage
    REPO=$(git rev-parse --show-toplevel) || die "Not in a git repository: $PWD"
    "$HANDLER" "$ADDR" review "$REPO" "$2"
    ;;
  reload)
    [ $# -eq 1 ] || bad_usage
    "$HANDLER" "$ADDR" reload
    ;;
  *)
    bad_usage
    ;;
esac
