#!/usr/bin/env bash
# tribe: minimal tmux implementation
#
#   tribe set NAME VALUE
#   tribe clear
#   tribe get [-i|--id ID] NAME
#
# ID identifies a participant. Without it, get reads the caller's own
# properties.
#

: ${TRIBE_PREFIX:=tribe}
PREFIX="@${TRIBE_PREFIX}"

usage() {
  echo "usage: $0 set NAME VALUE | $0 clear | $0 get [-i|--id ID] NAME" >&2
  exit 2
}

tmux_available() {
  [ -n "$TMUX" ]
}

pane_available() {
  [ -n "$TMUX_PANE" ]
}

tribe_options() {
  tmux show -p -t "$TMUX_PANE" | cut -d ' ' -f 1 | grep "^${PREFIX}_"
}

# tmux hooks have no TMUX_PANE
if ! tmux_available; then
  exit 1
fi

case "$1" in
  can-join)
    pane_available
    exit $?
    ;;
  set)
    pane_available || exit 1
    if [ $# -ne 3 ]; then
      usage
    fi
    tmux set -p -t "$TMUX_PANE" "${PREFIX}_$2" "$3"
    ;;
  clear)
    pane_available || exit 1
    for option in $(tribe_options); do
      tmux set -p -u -t "$TMUX_PANE" "$option"
    done
    ;;
  get)
    shift
    target=$TMUX_PANE
    if [ "$1" == -i -o "$1" == --id ]; then
      [ $# -ge 2 ] || usage
      target=$2
      shift 2
    fi
    if [ $# -ne 1 ]; then
      usage
    fi
    [ -n "$target" ] || exit 1
    tmux show -p -v -t "$target" "${PREFIX}_$1" 2> /dev/null
    ;;
  *)
    usage
    ;;
esac
