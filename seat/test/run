#!/usr/bin/env bash
#
# test/run: end-to-end tests of hunch-seat, through its service, with
# hunch-host mounting local:, the models it serves.
#
# Each test gets its own HOME, XDG directories, service and tmux servers,
# all under a temporary directory: the human's own service and settings
# stay untouched. A test that needs a client attached to tmux runs it in
# a second tmux server, as a terminal.
#
# HUNCH_TEST_MODEL, a speech model in the human's Hugging Face cache, adds
# the tests that load and run it; they make speech with macOS's say.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ROOT=$(dirname "$CURDIR")
HOST=$ROOT/target/debug/hunch-seat
HUNCH_HOST=$(dirname "$ROOT")/host/target/debug
# The tests make their own; a model test reads the human's
REAL_HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
# Short, since a unix socket's path has room for about 100 bytes
DIR=$(mktemp -d /tmp/hunch-seat-test.XXXXXX)
FAILED=0
N=0

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

cleanup() {
  stop
  rm -rf "$DIR"
}

# Run hunch-seat ARGS with stdin from IN; sets OUT, ERR and STATUS
call() {
  STATUS=0
  "$HOST" "$@" < "$IN" > "$TEST_DIR/out" 2> "$TEST_DIR/err" || STATUS=$?
  OUT=$(< "$TEST_DIR/out")
  ERR=$(< "$TEST_DIR/err")
}

# Wait up to five seconds for COMMAND to succeed
wait_for() {
  local i
  for i in $(seq 50); do
    "$@" && return
    sleep 0.1
  done
  return 1
}

serve() {
  "$HOST" serve 2>> "$TEST_DIR/serve.log" &
  SERVICE=$!
  wait_for [ -S "$XDG_RUNTIME_DIR/hunch/sock/seat.sock" ] ||
    die "The service didn't start: $(< "$TEST_DIR/serve.log")"
}

teardown() {
  local pid
  stop
  pid=$(cat "$XDG_RUNTIME_DIR/hunch/hunch-host.pid" 2> /dev/null) &&
    kill "$pid" 2> /dev/null
  [ -n "$SERVER" ] && kill "$SERVER" 2> /dev/null
  SERVER=
  t kill-server 2> /dev/null || true
  terminal kill-server 2> /dev/null || true
}

stop() {
  [ -n "$SERVICE" ] || return 0
  kill "$SERVICE" 2> /dev/null || true
  wait "$SERVICE" 2> /dev/null || true
  SERVICE=
}

# tmux, the one the tests ask hunch-seat about
t() {
  tmux -f /dev/null -S "$TMUX_SOCKET" "$@"
}

# tmux, the terminal a client of t runs in
terminal() {
  tmux -f /dev/null -S "$TEST_DIR/terminal" "$@"
}

# Start t with session one: ARGS run in its first pane
session() {
  t new-session -d -s one -x 80 -y 24 "$@"
}

# Attach a client to t, as a human in a terminal does
attach() {
  terminal new-session -d -x 80 -y 24 \
    "TMUX= tmux -f /dev/null -S '$TMUX_SOCKET' attach -t one"
  wait_for attached || die "No client attached"
}

attached() {
  [ -n "$(t list-clients)" ]
}

# Whether PANE runs PROGRAM in the foreground
runs() {
  [ "$(t display-message -p -t "$1" '#{pane_current_command}')" == "$2" ]
}

# Whether PANE asked for bracketed paste. tmux before 3.8 doesn't say,
# and tells nothing rather than 0.
pasting() {
  [ "$(t display-message -p -t "$1" '#{bracket_paste_flag}')" != 0 ]
}

wm() {
  call wm "tmux:$TMUX_SOCKET" "$@"
}

# A field of each window, one per line
windows() {
  wm windows
  jq -r ".[] | .id + \" \" + (.$1 | tostring)" <<< "$OUT"
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ $2 == *"$3"* ]] && return
  echo "# $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

macos() {
  [ "$(uname)" == Darwin ]
}

test_help() {
  call --help
  check status "$STATUS" 0
  check_has out "$OUT" "Usage: hunch-seat"
  call
  check status "$STATUS" 1
  check_has err "$ERR" "missing ROLE"
  call frobnicate
  check status "$STATUS" 1
  check_has err "$ERR" "unknown role"
}

test_wms() {
  call wms
  check status "$STATUS" 0
  if macos; then
    check wms "$OUT" '["macos:"]'
  else
    check wms "$OUT" '[]'
  fi
}

test_tmux_windows() {
  session
  t split-window -h -t one
  t new-window -t one
  wm windows
  check status "$STATUS" 0
  check ids "$(jq -r '.[].id' <<< "$OUT" | sort)" \
    "$(t list-panes -a -F '#{pane_id}' | sort)"
  check fields "$(jq -r '.[0] | keys | join(" ")' <<< "$OUT")" \
    'app focused height host id pid state title tty visible width workspace x y'
  # Nobody looks at a session without a client
  check visible "$(jq '[.[] | select(.visible)] | length' <<< "$OUT")" 0
  attach
  check visible "$(windows visible | sort)" "%0 false
%1 false
%2 true"
  check focused "$(windows focused | grep true)" "%2 true"
}

test_tmux_context() {
  session
  t split-window -t one
  attach
  wm context
  check status "$STATUS" 0
  check window "$(jq -r .window.id <<< "$OUT")" %1
  check workspace "$(jq -r .workspace.name <<< "$OUT")" one:0
  t select-pane -t %0
  wm context --client "$(t list-clients -F '#{client_tty}')"
  check client "$(jq -r .window.id <<< "$OUT")" %0
}

test_tmux_context_without_client() {
  session
  wm context
  check status "$STATUS" 1
  check_has err "$ERR" "no client is attached"
}

test_tmux_send() {
  session "cat > '$TEST_DIR/typed'"
  wait_for runs %0 cat || die "The program didn't start"
  printf 'echo hi; rm -rf x' > "$IN"
  wm send %0
  check status "$STATUS" 0
  : > "$IN"
  wm submit %0
  check status "$STATUS" 0
  wait_for [ -s "$TEST_DIR/typed" ] || true
  check typed "$(< "$TEST_DIR/typed")" "echo hi; rm -rf x"
}

test_tmux_send_brackets_a_paste() {
  # A program that asks for bracketed paste, as shells and Vim do
  session "printf '\\033[?2004h'; exec head -1 > '$TEST_DIR/typed'"
  wait_for runs %0 head || die "The program didn't start"
  wait_for pasting %0 || die "No bracketed paste in %0"
  printf 'hi' > "$IN"
  wm send %0
  : > "$IN"
  wm submit %0
  wait_for [ -s "$TEST_DIR/typed" ] || true
  check typed "$(cat -v "$TEST_DIR/typed")" '^[[200~hi^[[201~'
}

test_tmux_gone() {
  session
  wm submit %9
  check status "$STATUS" 4
  check_has err "$ERR" "can't find pane"
}

test_tmux_move() {
  session
  t split-window -h -t one
  # Only a pane the human sees is a neighbour
  attach
  wm move %0 right
  check status "$STATUS" 0
  check out "$OUT" "swapped %0 and %1"
  check order "$(windows x | sort -k2 -n | cut -d' ' -f1 | paste -sd' ' -)" \
    "%1 %0"
  wm move %0 right
  check status "$STATUS" 1
  check_has err "$ERR" "no window right of %0"
}

test_tmux_state() {
  session
  t split-window -t one
  attach
  wm state %0 maximized
  check status "$STATUS" 0
  check state "$(windows state)" "%0 maximized
%1 normal"
  check visible "$(windows visible)" "%0 true
%1 false"
  wm state %0 normal
  check state "$(windows state)" "%0 normal
%1 normal"
  wm state %0 minimized
  check status "$STATUS" 1
  check_has err "$ERR" "only normal and maximized"
}

test_tmux_focus() {
  session
  t new-window -t one
  attach
  wm focus %0
  check status "$STATUS" 0
  wm context
  check window "$(jq -r .window.id <<< "$OUT")" %0
}

test_wm_usage() {
  call wm
  check status "$STATUS" 1
  check_has err "$ERR" "missing ADDR or COMMAND"
  call wm nowhere windows
  check status "$STATUS" 1
  check_has err "$ERR" "ADDR has no SCHEME"
  call wm x11: windows
  check status "$STATUS" 1
  check_has err "$ERR" "no wm of SCHEME x11"
  wm state %0 sideways
  check status "$STATUS" 1
  check_has err "$ERR" "unknown STATE"
}

test_macos_displays() {
  macos || return 0
  call wm macos: displays
  check status "$STATUS" 0
  check main "$(jq '[.[] | select(.main)] | length' <<< "$OUT")" 1
  check fields "$(jq -c '.[0] | keys' <<< "$OUT")" \
    '["height","id","main","name","width","x","y"]'
}

test_service_runs_once() {
  call serve
  check status "$STATUS" 1
  check_has err "$ERR" "a service already runs"
}

test_service_replaces_a_stale_socket() {
  kill -9 "$SERVICE"
  wait "$SERVICE" 2> /dev/null || true
  serve
  call wms
  check status "$STATUS" 0
}

test_service_is_needed() {
  stop
  call wms
  check status "$STATUS" 1
  check_has err "$ERR" "start it with hunch-seat serve"
}

test_service_ends_the_command_of_a_gone_client() {
  local sent
  session
  # A send that waits for its text, and its client that goes away
  sleep 60 | "$HOST" wm "tmux:$TMUX_SOCKET" send %0 &
  sent="send %0"
  wait_for [ "$(running "$sent")" == 2 ] || true
  check served "$(running "$sent")" 2
  kill $!
  wait_for none "$sent" || true
  check ended "$(running "$sent")" 0
  pkill -f "sleep 60" || true
}

# How many processes run COMMAND: the client, and the command the
# service runs for it
running() {
  pgrep -f "$1" | wc -l | tr -d ' '
}

none() {
  [ "$(running "$1")" == 0 ]
}

test_needs() {
  call needs --all
  check status "$STATUS" 0
  if macos; then
    check grants "$(jq -r '.[].grant' <<< "$OUT" | paste -sd, -)" \
      "Screen Recording,Accessibility,Microphone"
    check fields "$(jq -c '.[0] | keys' <<< "$OUT")" '["for","grant","granted"]'
  else
    check grants "$(jq -r '.[].grant' <<< "$OUT" | paste -sd, -)" "group input"
  fi
  call needs --now
  check status "$STATUS" 1
  check_has err "$ERR" "unknown flag: --now"
}

# A GGUF file with no tensors and the string KEY=VALUE metadata given
gguf() {
  local file=$1
  local pair
  shift
  mkdir -p "$(dirname "$file")"
  {
    printf 'GGUF'
    le 4 3
    le 8 0
    le 8 $#
    for pair in "$@"; do
      string "${pair%%=*}"
      le 4 8
      string "${pair#*=}"
    done
  } > "$file"
}

# NUMBER in SIZE bytes, little-endian
le() {
  local i
  for i in $(seq 0 $(($1 - 1))); do
    printf "\\$(printf '%03o' $((($2 >> (8 * i)) & 255)))"
  done
}

string() {
  le 8 ${#1}
  printf '%s' "$1"
}

# A WAV as local: takes it: 16-bit PCM, 16 kHz, mono; a second of silence
wav() {
  local samples=16000
  printf 'RIFF'
  le 4 $((36 + 2 * samples))
  printf 'WAVEfmt '
  le 4 16
  le 2 1
  le 2 1
  le 4 16000
  le 4 32000
  le 2 2
  le 2 16
  printf 'data'
  le 4 $((2 * samples))
  head -c $((2 * samples)) /dev/zero
}

# A repo of the Hugging Face cache: REPO, then its files under
# snapshots/, each with the metadata after it, up to the next file
hub() {
  local repo=$HF_HOME/hub/models--${1/\//--}
  shift
  mkdir -p "$repo/snapshots" "$repo/refs"
  while [ $# -gt 0 ]; do
    local file=$1
    local metadata=()
    shift
    while [ $# -gt 0 ] && [[ $1 == *=* ]]; do
      metadata+=("$1")
      shift
    done
    gguf "$repo/snapshots/$file" "${metadata[@]}"
  done
}

# Reads PATH of the host's workspace; sets OUT, ERR and STATUS
tree() {
  STATUS=0
  hunch-9p "$@" < "$IN" > "$TEST_DIR/out" 2> "$TEST_DIR/err" || STATUS=$?
  OUT=$(< "$TEST_DIR/out")
  ERR=$(< "$TEST_DIR/err")
}

# A request to transcribe with MODEL, TYPE, then stdin, into IN
request() {
  local speech
  speech=$(mktemp "$TEST_DIR/speech.XXXXXX")
  cat > "$speech"
  {
    printf '{"model": "%s", "type": "%s"}\n' "$1" "$2"
    cat "$speech"
  } \
    > "$IN"
}

test_inference_models() {
  hub org/speech main/speech-Q8_0.gguf stt.encoder=x general.name=Speech
  echo main > "$HF_HOME/hub/models--org--speech/refs/main"
  hub org/speech old/speech-old.gguf stt.encoder=x
  # Pinned, as Handy fetches them: no refs/main
  hub org/two rev/two-Q4_K.gguf stt.encoder=x rev/two-Q8_0.gguf stt.encoder=x
  hub org/chat rev/chat-Q4_K.gguf general.name=Chat
  gguf "$TEST_DIR/mine/pub/model/mine.gguf" stt.encoder=x
  echo "$TEST_DIR/mine" > "$XDG_CONFIG_HOME/hunch/models"
  tree read inference/models
  check status "$STATUS" 0
  check ids "$(jq -r '.[].id' <<< "$OUT" | paste -sd' ' -)" \
    "org/speech org/two:Q4_K org/two:Q8_0 pub/model/mine.gguf"
  local speech='{"id":"org/speech","inputs":["audio/wav"],"loaded":false,'
  speech+='"name":"Speech","outputs":["text/plain"]}'
  check speech "$(jq -cS '.[0] | del(.size)' <<< "$OUT")" "$speech"
  local gguf=$HF_HOME/hub/models--org--speech/snapshots/main/speech-Q8_0.gguf
  check size "$(jq '.[0].size' <<< "$OUT")" "$(wc -c < "$gguf" | tr -d ' ')"
}

test_inference_errors() {
  hub org/speech rev/speech.gguf stt.encoder=x
  wav | request org/none audio/wav
  tree rdwr inference/transcribe
  check unknown "$STATUS" 1
  check_has err "$ERR" "no model org/none"
  wav | request org/speech text/plain
  tree rdwr inference/transcribe
  check_has err "$ERR" "doesn't take text/plain"
  wav | request org/speech audio/wav
  tree rdwr inference/transcribe
  check_has err "$ERR" "can't load org/speech"
  echo hello | request org/speech audio/wav
  tree rdwr inference/transcribe
  check_has err "$ERR" "isn't a WAV file"
  printf hello > "$IN"
  tree rdwr inference/transcribe
  check_has err "$ERR" "a line of JSON first"
}

test_inference_transcribes() {
  [ -n "$HUNCH_TEST_MODEL" ] && macos || return 0
  ln -s "$REAL_HF_HOME/hub" "$HF_HOME/hub"
  say -o "$TEST_DIR/hello.wav" --data-format=LEI16@16000 "Hello world"
  request "$HUNCH_TEST_MODEL" audio/wav < "$TEST_DIR/hello.wav"
  tree rdwr inference/transcribe
  check status "$STATUS" 0
  check_has text "$(tr '[:upper:]' '[:lower:]' <<< "$OUT")" hello
  tree read inference/models
  check loaded "$(jq --arg id "$HUNCH_TEST_MODEL" \
    '.[] | select(.id == $id) | .loaded' <<< "$OUT")" true
}

seat() {
  call seat "$@"
}

test_seat_context() {
  macos || return 0
  seat context
  check status "$STATUS" 0
  local fields="error idle key loading locked model opening"
  fields+=" picking preload recording submit target transcribing warm wm"
  check fields "$(jq -r 'keys | join(" ")' <<< "$OUT")" "$fields"
  local defaults='{"key":"right-super","model":null,"target":"focus",'
  defaults+='"submit":true,"preload":true,"warm":null}'
  check defaults "$(jq -c '{key, model, target, submit, preload, warm}' \
    <<< "$OUT")" "$defaults"
}

test_seat_settings_stay() {
  macos || return 0
  hub org/speech rev/speech.gguf stt.encoder=x
  seat key right-alt
  check status "$STATUS" 0
  seat submit off
  seat preload off
  seat warm 10
  seat target macos: 1
  seat model org/speech
  check status "$STATUS" 0
  stop
  serve
  seat context
  local settings='{"key":"right-alt","model":"org/speech",'
  settings+='"target":"macos: 1",'
  settings+='"submit":false,"preload":false,"warm":10}'
  check settings "$(jq -c '{key, model, target, submit, preload, warm}' \
    <<< "$OUT")" "$settings"
}

test_seat_errors() {
  macos || return 0
  seat key caps-lock
  check status "$STATUS" 1
  check_has err "$ERR" "KEY is one of right-super"
  seat model org/none
  check status "$STATUS" 4
  seat warm 0
  check status "$STATUS" 1
  check_has err "$ERR" "MINUTES is a whole number above 0"
  seat submit maybe
  check status "$STATUS" 1
  check_has err "$ERR" "unknown command"
  seat target tmux:/tmp/x %1
  check status "$STATUS" 1
  seat last
  check status "$STATUS" 1
  check_has err "$ERR" "nothing dictated"
}

test_seat_devices() {
  seat devices
  check status "$STATUS" 0
  # A runner without a microphone lists none
  [ "$(jq length <<< "$OUT")" -gt 0 ] || return 0
  check kinds "$(jq -c '[.[].kind] | unique' <<< "$OUT")" '["mic"]'
  check fields "$(jq -c '.[0] | keys' <<< "$OUT")" \
    '["id","in_use","kind","name","signal"]'
  check one "$(jq '[.[] | select(.in_use)] | length' <<< "$OUT")" 1
}

# Serves the files under DIR over HTTP; sets URL to the server's /v1
http_server() {
  python3 -u -m http.server --bind 127.0.0.1 --directory "$1" 0 \
    > "$TEST_DIR/http.log" 2>&1 &
  SERVER=$!
  wait_for grep -q "port" "$TEST_DIR/http.log" ||
    die "The HTTP server didn't start: $(< "$TEST_DIR/http.log")"
  URL=http://127.0.0.1:$(sed -n 's/.* port \([0-9]*\).*/\1/p' \
    "$TEST_DIR/http.log")/v1
}

test_seat_model_of_a_server() {
  macos || return 0
  mkdir -p "$TEST_DIR/www/v1"
  cat > "$TEST_DIR/www/v1/models" << 'EOF'
{
  "data": [
    {"id": "parakeet", "task": "automatic-speech-recognition"},
    {"id": "qwen", "display_name": "Qwen"}
  ]
}
EOF
  http_server "$TEST_DIR/www"
  echo "mount $URL /inference" > "$XDG_CONFIG_HOME/hunch/namespace"
  seat model qwen
  check_has qwen "$ERR" "qwen doesn't turn speech into text"
  seat model none
  check unknown "$STATUS" 4
  check_has err "$ERR" "inference has no model none"
  seat model parakeet
  check model "$STATUS" 0
  seat context
  check context "$(jq -r .model <<< "$OUT")" parakeet
}

test_seat_menu() {
  seat menu
  check status "$STATUS" 0
  check settings "$(jq -c '.[-1]' <<< "$OUT")" \
    '{"settings":"","title":"Settings…"}'
  check redirect \
    "$(jq -r '.[] | select(.ctl == "redirect") | .title' <<< "$OUT")" \
    "Redirect to Window…"
  macos || return 0
  seat target macos: 1
  seat menu
  check stop \
    "$(jq -r '.[] | select(.ctl == "target focus") | .title' <<< "$OUT")" \
    "Stop Redirect to macos: 1"
}

test_seat_watch() {
  macos || return 0
  "$HOST" seat watch > "$TEST_DIR/watch" &
  wait_for [ -s "$TEST_DIR/watch" ] || true
  seat submit off
  wait_for [ "$(wc -l < "$TEST_DIR/watch")" -ge 2 ] || true
  kill $!
  check lines "$(jq -c .submit "$TEST_DIR/watch" | paste -sd' ' -)" "true false"
}

run() {
  local failed=$FAILED
  N=$((N + 1))
  TEST=$1
  TEST_DIR=$DIR/$N
  IN=$TEST_DIR/in
  TMUX_SOCKET=$TEST_DIR/tmux
  mkdir -p "$TEST_DIR/home" "$TEST_DIR/run" "$TEST_DIR/config/hunch" \
    "$TEST_DIR/state" "$TEST_DIR/hf"
  : > "$IN"
  (
    export PATH=$DIR/bin:$PATH
    export HOME=$TEST_DIR/home
    export XDG_RUNTIME_DIR=$TEST_DIR/run
    export XDG_CONFIG_HOME=$TEST_DIR/config
    export XDG_STATE_HOME=$TEST_DIR/state
    export HF_HOME=$TEST_DIR/hf
    trap teardown EXIT
    serve
    "$1"
    exit $((FAILED - failed))
  ) || FAILED=$((FAILED + $?))
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v jq > /dev/null || die "jq is not installed"
command -v tmux > /dev/null || die "tmux is not installed"
trap cleanup EXIT
unset HUNCH_SEAT_SERVED TMUX TMUX_PANE
(cd "$ROOT" && cargo build -q) || die "Can't build hunch-seat"
(cd "$ROOT/../host" && cargo build -q) || die "Can't build hunch-host"
mkdir "$DIR/bin"
ln -s "$HOST" "$DIR/bin/hunch-seat"
ln -s "$HUNCH_HOST/hunch-9p" "$HUNCH_HOST/hunch-host" "$DIR/bin"
# The OS's stores of secrets, as far as hunch-host uses them: keys in
# $HOME/keys, a file each, and every command line in $HOME/keys/argv
cat > "$DIR/bin/security" << 'EOF'
#!/usr/bin/env bash
mkdir -p "$HOME/keys"
echo "$*" >> "$HOME/keys/argv"
if [ "$1" == -i ]; then
  read -r line
  eval "set -- $line"
fi
while [ $# -gt 0 ]; do
  case $1 in
    -a) host=$2 ;;
    -w) [ $# -gt 1 ] && key=$2 ;;
  esac
  shift
done
if [ -n "$key" ]; then
  printf '%s' "$key" > "$HOME/keys/$host"
else
  cat "$HOME/keys/$host" 2> /dev/null || exit 44
fi
EOF
cat > "$DIR/bin/secret-tool" << 'EOF'
#!/usr/bin/env bash
mkdir -p "$HOME/keys"
echo "$*" >> "$HOME/keys/argv"
host=${!#}
if [ "$1" == store ]; then
  cat > "$HOME/keys/$host"
else
  cat "$HOME/keys/$host" 2> /dev/null || exit 1
fi
EOF
chmod +x "$DIR/bin/security" "$DIR/bin/secret-tool"

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
